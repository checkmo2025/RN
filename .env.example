# Public values only (bundled into app JS at build time)
EXPO_PUBLIC_API_BASE_URL=https://api.checkmo.co.kr/api/v1
EXPO_PUBLIC_WS_BASE_URL=wss://api.checkmo.co.kr/ws-stomp
EXPO_PUBLIC_WEB_BASE_URL=https://checkmo.co.kr
EXPO_PUBLIC_SUPPORT_FORM_URL=https://www.checkmo.co.kr/support
EXPO_PUBLIC_YES24_RANKING_URL=https://www.yes24.com/Product/Category/BestSeller?categoryNumber=001

# Optional if app.config.ts uses it
EXPO_PUBLIC_APP_SCHEME=checkmo

# Never put secrets in frontend env (EXPO_PUBLIC_ / app.json / extra):
# - OAuth provider client secret
# - Server signing keys / JWT secret
# - DB credentials / SMTP credentials
# - Admin API tokens / service account private keys
