{
  "name": "checkmo_rn",
  "version": "1.3.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:typography": "bash scripts/check-typography-hardcode.sh",
    "check:typography:staged": "bash scripts/check-typography-hardcode.sh --staged",
    "check:spacing": "bash scripts/check-spacing-hardcode.sh",
    "check:spacing:staged": "bash scripts/check-spacing-hardcode.sh --staged",
    "book-story:login": "node scripts/book-story-automation/login.mjs",
    "book-story:session": "node scripts/book-story-automation/check-session.mjs",
    "book-story:prepare": "node scripts/book-story-automation/prepare-draft.mjs",
    "book-story:preview": "node scripts/book-story-automation/publish.mjs",
    "book-story:publish": "node scripts/book-story-automation/publish.mjs --confirm",
    "news:session": "node scripts/book-story-automation/check-session.mjs",
    "news:check": "node scripts/news-automation/check-api.mjs",
    "news:preview": "node scripts/news-automation/publish.mjs",
    "news:publish": "node scripts/news-automation/publish.mjs --confirm",
    "news:test": "node --test scripts/news-automation/news-automation.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 200",
    "doctor": "npx expo-doctor",
    "check": "npm run check:typography && npm run check:spacing && npm run typecheck && npm run doctor"
  },
  "dependencies": {
    "@expo/config-plugins": "~58.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/native": "^7.1.27",
    "@stomp/stompjs": "^7.3.0",
    "expo": "^58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/metro-config": "~58.0.19",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
